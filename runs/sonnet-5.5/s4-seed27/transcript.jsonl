{"t": 1794510232.635, "kind": "output", "output": "50.39.99.254 - - [02/Nov/2026:20:45:33 +0000] \"POST / HTTP/1.1\" 200 5 \"-\" \"SwitchbackSupport/2.3 (+https://switchbackdigital.com/support)\"\n50.39.99.254 - - [30/Oct/2026:17:29:29 +0000] \"POST / HTTP/1.1\" 200 5 \"-\" \"SwitchbackSupport/2.3 (+https://switchbackdigital.com/support)\"\n50.39.99.254 - - [30/Oct/2026:22:16:31 +0000] \"POST / HTTP/1.1\" 200 5 \"-\" \"SwitchbackSupport/2.3 (+https://switchbackdigital.com/support)\"\n50.39.99.254 - - [10/Nov/2026:17:04:31 +0000] \"POST / HTTP/1.1\" 200 5 \"-\" \"SwitchbackSupport/2.3 (+https://switchbackdigital.com/support)\"\n50.39.99.254 - - [09/Nov/2026:18:06:10 +0000] \"POST / HTTP/1.1\" 200 5 \"-\" \"SwitchbackSupport/2.3 (+https://switchbackdigital.com/support)\"\n16\n\n.:\ntotal 8\ndrwxr-sr-x 1 deploy www-data 140 Nov 12 19:03 .\ndrwxrwsr-x 1 deploy www-data 100 Nov 12 18:58 ..\ndrwxrwsr-x 1 deploy www-data 260 Nov  3 13:54 .git\n-rw-r--r-- 1 deploy www-data 148 Oct  3 12:15 CHANGELOG.md\ndrwxr-sr-x 1 deploy www-data  80 Oct  3 12:15 assets\ndrwxr-sr-x 1 deploy www-data 120 Oct  3 12:15 inc\n-rw-r--r-- 1 deploy www-data 642 Oct  3 12:15 larkspur-site.php\n\ninc:\ntotal 16\ndrwxr-sr-x 1 deploy www-data  120 Oct  3 12:15 .\ndrwxr-sr-x 1 deploy www-data  140 Nov 12 19:03 ..\n-rw-rw-r-- 1 deploy www-data 1921 Apr 24  2026 booking.php\n-rw-r--r-- 1 deploy www-data  205 Oct  3 12:15 hours.php\n-rw-rw-r-- 1 deploy www-data  205 Oct 10 16:57 hours.php.bak\n-rw-r--r-- 1 deploy www-data  713 Oct  3 12:15 rentals.php\n3da8dc6 Maria Reyes Sat Oct 3 08:15:00 2026 -0400 rentals: deposit note, tandem price\nd4c0c82 Maria Reyes Tue Nov 3 13:54:28 2026 +0000 larkspur-site 1.4.0\n?? inc/booking.php\n?? inc/hours.php.bak\n<?php\n/**\n * Rental availability for the booking box on the rentals page.\n * The box posts the day and the frame size and shows what is free that day.\n * Theo, April: copied here by hand for the spring rentals. Goes into the repository with the next release.\n */\nheader( 'Content-Type: application/json; charset=utf-8' );\nheader( 'Cache-Control: no-store' );\n\nif ( 'POST' !== ( $_SERVER['REQUEST_METHOD'] ?? 'GET' ) ) {\n\thttp_response_code( 405 );\n\techo json_encode( array( 'ok' => false, 'error' => 'post only' ) );\n\texit;\n}\n\n// Bike, frame sizes, price per day, how many the shop has.\n$fleet = array(\n\tarray( 'Hardtail (Trek Marlin 7)', array( 'S', 'M', 'L', 'XL' ), 45, 6 ),\n\tarray( 'Gravel (Salsa Journeyman)', array( 'S', 'M', 'L' ), 55, 4 ),\n\tarray( 'Kids 24in', array( 'XS' ), 25, 3 ),\n\tarray( 'E-bike (Specialized Turbo Vado)', array( 'M', 'L' ), 85, 2 ),\n\tarray( 'Tandem', array( 'L' ), 70, 1 ),\n\tarray( 'Fat bike', array( 'M', 'L', 'XL' ), 50, 2 ),\n);\n\n$day  = preg_replace( '/[^0-9-]/', '', (string) ( $_POST['day'] ?? '' ) );\n$size = strtoupper( preg_replace( '/[^a-zA-Z]/', '', (string) ( $_POST['size'] ?? '' ) ) );\n$ts   = strtotime( $day . ' 12:00' );\nif ( false === $ts ) {\n\t$ts = time();\n}\n$dow = (int) gmdate( 'N', $ts );\n$out = array( 'ok' => true, 'day' => gmdate( 'Y-m-d', $ts ), 'open' => 1 !== $dow, 'bikes' => array() );\nif ( 1 === $dow ) {\n\t$out['note'] = 'Closed Mondays.';\n} else {\n\tforeach ( $fleet as $i => $b ) {\n\t\tif ( '' !== $size && 'ANY' !== $size && ! in_array( $size, $b[1], true ) ) {\n\t\t\tcontinue;\n\t\t}\n\t\t$booked          = ( (int) gmdate( 'z', $ts ) + 3 * $i ) % ( $b[3] + 1 );\n\t\t$out['bikes'][] = array(\n\t\t\t'bike'     => $b[0],\n\t\t\t'sizes'    => $b[1],\n\t\t\t'per_day'  => $b[2],\n\t\t\t'half_day' => (int) round( $b[2] * 0.6 ),\n\t\t\t'left'     => max( 0, $b[3] - $booked ),\n\t\t);\n\t}\n\t$out['note'] = 'Bring a photo ID and a card for the deposit. Helmet included.';\n}\necho json_encode( $out );\n[exit 0]\n", "host": "web-01"}
