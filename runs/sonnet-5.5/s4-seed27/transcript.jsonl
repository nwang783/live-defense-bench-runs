{"t": 1794510420.536, "kind": "output", "output": "server {\n    listen 80 default_server;\n    server_name larkspurcycles.com www.larkspurcycles.com;\n    root /var/www/larkspur;\n    index index.php;\n    client_max_body_size 16m;\n\n    access_log /var/log/nginx/larkspur.access.log;\n    error_log /var/log/nginx/larkspur.error.log;\n\n    location / {\n        try_files $uri $uri/ /index.php?$args;\n    }\n\n    # No PHP from user-writable folders (uploads, cache): customers upload files here.\n    location ~* ^/wp-content/(uploads|cache)/.*\\.(php[0-9]?|phtml|phar)$ {\n        deny all;\n    }\n\n    location ~ \\.php$ {\n        include snippets/fastcgi-php.conf;\n        fastcgi_pass unix:/run/php/php8.2-fpm.sock;\n    }\n\n    location ~* \\.(css|js|jpg|jpeg|png|gif|svg|woff2?)$ {\n        expires 7d;\n        access_log off;\n    }\n\n    location ~ /\\.(ht|git) {\n199:    # No PHP from user-writable folders (uploads, cache): customers upload files here.\n200:    location ~* ^/wp-content/(uploads|cache)/.*\\.(php[0-9]?|phtml|phar)$ {\nHTTP/1.1 403 Forbidden\r\nServer: nginx/1.22.1\r\nDate: Thu, 12 Nov 2026 19:07:00 GMT\r\nContent-Type: text/html\r\nContent-Length: 153\r\nConnection: keep-alive\r\n\r\n<html>\r\n[exit 0]\n", "host": "web-01"}
