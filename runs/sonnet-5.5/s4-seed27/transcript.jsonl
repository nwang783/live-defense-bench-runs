00\u0000\u0002\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000h0\u0000\u0000\u0000\u0000\u0000\u0000�\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u001d\u0000\u0000\u0000\u0012\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0018\u0000\u0000\u0000\u0000\u0000\u0000\u0000\t\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000@4\u0000\u0000\u0000\u0000\u0000\u00003\u0002\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0011\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000s6\u0000\u0000\u0000\u0000\u0000\u0000\u001a\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000/opt/acme-pos:\ntotal 0\ndrwxr-xr-x 1 root root  60 Nov  3 13:54 .\ndrwxr-xr-x 1 root root 100 Nov  3 13:54 ..\ndrwxr-xr-x 1 root root  60 Nov  3 13:54 bin\n\n/opt/acme-pos/bin:\ntotal 16\ndrwxr-xr-x 1 root root    60 Nov  3 13:54 .\ndrwxr-xr-x 1 root root    60 Nov  3 13:54 ..\n-rwxr-xr-x 1 root root 16208 Nov  3 13:53 acme-poscollect\ntotal 8\ndrwxr-xr-x 2 root root  47 Nov  3 13:54 .\ndrwxr-xr-x 1 root root 620 Nov 12 18:58 ..\n-rw------- 1 root root  35 Nov  3 13:54 till.log\n===\n#!/bin/sh\n# Release step run by CI after it pushes theme and plugin changes: fix modes, clear caches, reload PHP.\nset -eu\ncd /var/www/larkspur\nchown -R deploy:www-data wp-content/themes\nchown -R www-data:www-data wp-content/uploads\nsudo -u www-data wp --path=/var/www/larkspur cache flush >/dev/null 2>&1 || true\n[ -x /usr/local/bin/larkspur-restart ] && /usr/local/bin/larkspur-restart >/dev/null 2>&1 \\\n    || service php8.2-fpm reload >/dev/null\nlogger -t larkspur-deploy \"release ${1:-manual} done\"\necho \"release ${1:-manual} done\"\n#!/bin/sh\n# Restart the web stack after a release: clear the page cache, reload PHP, reload nginx.\nset -eu\ncd /var/www/larkspur\nsudo -u www-data wp --path=/var/www/larkspur cache flush >/dev/null 2>&1 || true\nservice php8.2-fpm reload >/dev/null\nservice nginx reload >/dev/null\nlogger -t larkspur-restart \"restart ${1:-manual} done\"\necho \"restart ${1:-manual} done\"\n[exit 0]\n", "host": "web-01"}
