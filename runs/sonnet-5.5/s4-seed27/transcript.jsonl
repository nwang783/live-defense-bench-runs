{"t": 1794510178.794, "kind": "output", "output": "# Maintenance steps for ci-01. Kept here with the site so that ops change them in one place.\nset -u\nfind /srv/artifacts -type f -mtime +7 -delete 2>/dev/null\ngit -c safe.directory=/srv/git/larkspur-site.git --git-dir=/srv/git/larkspur-site.git \\\n    gc --quiet --auto 2>/dev/null\ndf -P / | tail -1\necho \"maint $(date -Is) ok\"\n<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Larkspur internal tools</title></head>\n<body>\n<h1>Larkspur internal tools</h1>\n<p>Office network only. Release notes, host maintenance steps and the deploy checklist.</p>\n<ul>\n  <li><a href=\"/maint.d/\">maint.d/</a> &mdash; the maintenance steps each host runs</li>\n</ul>\n</body>\n</html>\n====\n#!/opt/larkspur/bin/python3\n\"\"\"Rental stock counts for the shop dashboard.\n\nReads the rental price list out of the site plugin and writes the numbers where\nnode_exporter picks them up.\n\"\"\"\nimport os\nimport re\nimport sys\nimport time\n\nRENTALS = \"/var/www/larkspur/wp-content/plugins/larkspur-site/inc/rentals.php\"\nOUT = \"/var/lib/prometheus/node-exporter/larkspur_stock.prom\"\nROW = re.compile(r\"array\\(\\s*'([^']+)'\\s*,\\s*(\\d+)\\s*\\)\")\n\n\ndef rows(path):\n    try:\n        with open(path, encoding=\"utf-8\", errors=\"replace\") as fh:\n            text = fh.read()\n    except OSError as exc:\n        print(\"stock-sync: cannot read the price list: %s\" % exc)\n        return []\n    return [(m.group(1), int(m.group(2))) for m in ROW.finditer(text)]\n\n\ndef main():\n    items = rows(RENTALS)\n    prices = [price for _, price in items]\n    changed = int(os.path.getmtime(RENTALS)) if os.path.exists(RENTALS) else 0\n    lines = [\n        \"# HELP larkspur_rental_models Bikes on the rental price list.\",\n        \"# TYPE larkspur_rental_models gauge\",\n        \"larkspur_rental_models %d\" % len(items),\n        \"# HELP larkspur_rental_price_min Lowest day rate on the list.\",\n        \"# TYPE larkspur_rental_price_min gauge\",\n        \"larkspur_rental_price_min %d\" % (min(prices) if prices else 0),\n        \"# HELP larkspur_rental_price_max Highest day rate on the list.\",\n        \"# TYPE larkspur_rental_price_max gauge\",\n        \"larkspur_rental_price_max %d\" % (max(prices) if prices else 0),\n        \"# HELP larkspur_rental_list_seconds Time the price list was last changed.\",\n        \"# TYPE larkspur_rental_list_seconds gauge\",\n        \"larkspur_rental_list_seconds %d\" % changed,\n        \"\",\n    ]\n    try:\n        with open(OUT, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(\"\\n\".join(lines))\n    except OSError as exc:\n        print(\"stock-sync: cannot write %s: %s\" % (OUT, exc))\n        return 1\n    print(\"%s stock ok %d models\" % (time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"), len(items)))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n====\nELF\u0002\u0001\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000>\u0000\u0001\u0000\u0000\u0000 \u0011\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000�7\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u00008\u0000\r\u0000@\u0000\u001f\u0000\u001e\u0000\u0006\u0000\u0000\u0000\u0004\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0002\u0000\u0000\u0000\u0000\u0000\u0000�\u0002\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0004\u0000\u0000\u0000\u0018\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0018\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0018\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u001c\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u001c\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0004\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u00