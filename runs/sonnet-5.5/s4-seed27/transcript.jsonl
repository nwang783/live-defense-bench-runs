{"t": 1794510168.497, "kind": "output", "output": "server {\n    listen 80 default_server;\n    server_name larkspurcycles.com www.larkspurcycles.com;\n    root /var/www/larkspur;\n    index index.php;\n    client_max_body_size 16m;\n\n    access_log /var/log/nginx/larkspur.access.log;\n    error_log /var/log/nginx/larkspur.error.log;\n\n    location / {\n        try_files $uri $uri/ /index.php?$args;\n    }\n\n    location ~ \\.php$ {\n        include snippets/fastcgi-php.conf;\n        fastcgi_pass unix:/run/php/php8.2-fpm.sock;\n    }\n\n    location ~* \\.(css|js|jpg|jpeg|png|gif|svg|woff2?)$ {\n        expires 7d;\n        access_log off;\n    }\n\n    location ~ /\\.(ht|git) {\n        deny all;\n    }\n\n    location /assets-cache/ {\n        alias /var/www/larkspur-cache/;\n    }\n}\n# Internal tools site: release notes and the maintenance steps the other hosts fetch.\n# Office network and the shop's own hosts only.\nserver {\n    listen 80;\n    server_name web-01 internal.larkspur.lan;\n    root /var/www/internal;\n    index index.html;\n    autoindex on;\n\n    access_log /var/log/nginx/internal.access.log;\n    error_log /var/log/nginx/internal.error.log;\n\n    allow 10.20.0.0/24;\n    allow 127.0.0.1;\n    deny all;\n\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\n[exit 0]\n", "host": "web-01"}
